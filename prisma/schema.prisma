// prisma/schema.prisma
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Note: In Prisma 7, url and directUrl are configured in prisma.config.ts, not here
}

enum CapabilityType {
  PROCESS
  MATERIAL
  FINISH
  CERTIFICATION
  INDUSTRY
  SERVICE
  COMPANY_TYPE
}

enum OnboardingMethod {
  IMPORT
  MANUAL
}

enum TypicalJobSize {
  PROTOTYPE
  LOW_VOLUME
  MEDIUM_VOLUME
  HIGH_VOLUME
}

enum PreferredContactMethod {
  EMAIL
  PHONE
  PLATFORM_ONLY
}

enum TypicalLeadTime {
  ONE_TWO_WEEKS
  TWO_FOUR_WEEKS
  ONE_THREE_MONTHS
  THREE_PLUS_MONTHS
  DEPENDS_ON_WORKLOAD
}

model Capability {
  id      String         @id @default(uuid()) @db.Uuid
  type    CapabilityType
  slug    String         @db.Text
  name    String         @db.Text
  aliases String[]       @default([]) @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  supplierProfiles ProfileCapability[]

  @@unique([type, slug])
  @@index([type])
  @@map("capabilities")

}

model ProfileCapability {
  id           String @id @default(uuid()) @db.Uuid
  supplierProfileId String @map("supplier_profile_id") @db.Uuid
  capabilityId String @map("capability_id") @db.Uuid

  // Optional fields for ranking / filtering later
  // Examples: "in_house", "outsourced", "partner"
  mode     String? @db.Text
  verified Boolean @default(false)

  // Optional but very useful for signup + enrichment + ranking
  // Examples: "signup", "import", "ai", "admin"
  source String? @db.Text
  isCore Boolean @default(false) @map("is_core")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  supplierProfile SupplierProfile @relation(fields: [supplierProfileId], references: [id], onDelete: Cascade)
  capability    Capability     @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([supplierProfileId, capabilityId])
  @@index([supplierProfileId])
  @@index([capabilityId])
  @@index([supplierProfileId, isCore])
  @@map("profile_capabilities")
  
}

// Buyer Profile - for buyers who source/manufacturing services
model BuyerProfile {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String  @unique @map("user_id") @db.Text
  firstName   String? @map("first_name") @db.Text
  lastName    String? @map("last_name") @db.Text
  email       String? @db.Text
  companyName String  @map("company_name") @db.Text
  jobTitle    String? @map("job_title") @db.Text
  phone       String? @db.Text
  city        String? @db.Text
  province    String? @db.Text

  // Account lifecycle / deactivation
  deactivated         Boolean   @default(false)
  deactivatedAt       DateTime? @map("deactivated_at") @db.Timestamptz(6)
  scheduledDeletionAt DateTime? @map("scheduled_deletion_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // AI enrichment (normalized JSON + lifecycle)
  aiSchema     Json?     @map("ai_schema")
  aiSummary    String?   @map("ai_summary") @db.Text
  aiStatus     String    @default("pending") @map("ai_status") @db.Text
  aiEnrichedAt DateTime? @map("ai_enriched_at") @db.Timestamptz(6)
  aiError      String?   @map("ai_error") @db.Text

  sourcingRequests SourcingRequest[]

  @@index([province])
  @@index([createdAt(sort: Desc)])
  @@index([aiStatus])
  @@map("buyer_profiles")
}

// Supplier Profile - for suppliers/manufacturers who offer services
model SupplierProfile {
  id             String  @id @default(uuid()) @db.Uuid
  firstName      String? @map("first_name") @db.Text
  lastName       String? @map("last_name") @db.Text
  email          String  @unique @db.Text
  companyName    String  @map("company_name") @db.Text
  businessNumber String? @map("business_number") @db.Text
  website        String? @db.Text
  phone          String? @db.Text
  streetAddress  String  @map("street_address") @db.Text
  city           String? @db.Text
  province       String? @db.Text
  aboutUs        String? @map("about_us") @db.Text
  jobTitle       String? @map("job_title") @db.Text

  // Backward-compatible arrays (keep for now; migrate later to ProfileCapability)
  capabilities   String[] @default([]) @db.Text
  materials      String[] @default([]) @db.Text
  certifications String[] @default([]) @db.Text

  // Logistics & coverage (attributes, not taxonomy)
  provincesServed    String[] @default([]) @map("provinces_served") @db.Text // ["ON","QC",...]
  shippingCapability String?  @map("shipping_capability") @db.Text // "local" | "national" | "international"
  minOrderQty        Int?     @map("min_order_qty")
  leadTimeMinDays    Int?     @map("lead_time_min_days")
  leadTimeMaxDays    Int?     @map("lead_time_max_days")
  maxPartSizeMmX     Int?     @map("max_part_size_mm_x")
  maxPartSizeMmY     Int?     @map("max_part_size_mm_y")
  maxPartSizeMmZ     Int?     @map("max_part_size_mm_z")

  // Step 3: production profile (ranking)
  typicalJobSize TypicalJobSize? @map("typical_job_size")
  typicalLeadTime TypicalLeadTime? @map("typical_lead_time")

  // Industries served (fixed list: Precision Machining, Foundries & Casting, etc.)
  industriesServed String[] @default([]) @map("industries_served") @db.Text

  // Step 5: contact / RFQ preferences
  rfqEmail               String?                 @map("rfq_email") @db.Text
  preferredContactMethod PreferredContactMethod? @map("preferred_contact_method")

  // Verification status for directory filtering
  verified Boolean @default(false)

  // Internal (hidden) fields for eligibility + enrichment lifecycle
  searchable               Boolean           @default(false)
  profileCompletenessScore Int               @default(0) @map("profile_completeness_score")
  onboardingMethod         OnboardingMethod? @map("onboarding_method")
  taxonomyVersion          String            @default("v1") @map("taxonomy_version")
  lastVerifiedAt           DateTime?         @map("last_verified_at") @db.Timestamptz(6)

  // Account lifecycle / deactivation
  deactivated         Boolean   @default(false)
  deactivatedAt       DateTime? @map("deactivated_at") @db.Timestamptz(6)
  scheduledDeletionAt DateTime? @map("scheduled_deletion_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // AI enrichment (normalized JSON + lifecycle)
  aiSchema     Json?     @map("ai_schema")
  aiSummary    String?   @map("ai_summary") @db.Text
  aiStatus     String    @default("pending") @map("ai_status") @db.Text
  aiEnrichedAt DateTime? @map("ai_enriched_at") @db.Timestamptz(6)
  aiError      String?   @map("ai_error") @db.Text

  storefrontListings StorefrontListing[]

  // Normalized taxonomy relations
  profileCapabilities ProfileCapability[]

  @@index([searchable])
  @@index([province])
  @@index([verified])
  @@index([createdAt(sort: Desc)])
  @@index([aiStatus])
  @@map("supplier_profiles")
}

// Storefront Profile - for industrial storefront owners who create listings
// (Created from the standalone storefront signup in `app/become-supplier` wizardStep === 0).
model StorefrontProfile {
  id String @id @default(uuid()) @db.Uuid

  // Auth identifier (Firebase email is used as userId throughout the app)
  userId String @unique @map("user_id") @db.Text

  // Required storefront signup fields
  firstName     String? @map("first_name") @db.Text
  lastName      String? @map("last_name") @db.Text
  email         String? @db.Text
  companyName   String  @map("company_name") @db.Text
  role          String? @map("job_title") @db.Text
  streetAddress String   @map("street_address") @db.Text
  city          String? @db.Text
  province      String? @db.Text

  // Optional storefront enrichment (can be collected later)
  businessNumber String? @map("business_number") @db.Text
  website         String? @db.Text
  phone           String? @db.Text
  aboutUs         String? @map("about_us") @db.Text
  logoUrl         String? @map("logo_url") @db.Text
  selectedIcon    String? @map("selected_icon") @db.Text

  // Verification status for filtering / directory enrichment
  verified Boolean @default(false)

  // Internal fields for eligibility + enrichment lifecycle
  searchable               Boolean           @default(false)
  profileCompletenessScore Int               @default(0) @map("profile_completeness_score")
  onboardingMethod         OnboardingMethod? @map("onboarding_method")
  taxonomyVersion          String            @default("v1") @map("taxonomy_version")
  lastVerifiedAt           DateTime?         @map("last_verified_at") @db.Timestamptz(6)

  // Account lifecycle / deactivation
  deactivated         Boolean   @default(false)
  deactivatedAt       DateTime? @map("deactivated_at") @db.Timestamptz(6)
  scheduledDeletionAt DateTime? @map("scheduled_deletion_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // AI enrichment (normalized JSON + lifecycle)
  aiSchema     Json?     @map("ai_schema")
  aiSummary    String?   @map("ai_summary") @db.Text
  aiStatus     String    @default("pending") @map("ai_status") @db.Text
  aiEnrichedAt DateTime? @map("ai_enriched_at") @db.Timestamptz(6)
  aiError      String?   @map("ai_error") @db.Text

  storefrontListings StorefrontListing[]

  @@index([province])
  @@index([verified])
  @@index([createdAt(sort: Desc)])
  @@index([aiStatus])
  @@map("storefront_profiles")
}

model StorefrontListing {
  id          String   @id @default(uuid()) @db.Uuid
  profileId   String   @map("profile_id") @db.Uuid
  storefrontProfileId String? @map("storefront_profile_id") @db.Uuid
  title       String   @db.Text
  description String?  @db.Text
  price       String?  @db.Text
  category    String?  @db.Text
  badge       String?  @db.Text
  imageUrl    String?  @map("image_url") @db.Text
  listingType String?  @map("listing_type") @db.Text
  condition   String?  @db.Text
  location    String?  @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // AI enrichment (normalized JSON + lifecycle)
  aiSchema     Json?     @map("ai_schema")
  aiSummary    String?   @map("ai_summary") @db.Text
  aiStatus     String    @default("pending") @map("ai_status") @db.Text
  aiEnrichedAt DateTime? @map("ai_enriched_at") @db.Timestamptz(6)
  aiError      String?   @map("ai_error") @db.Text

  supplierProfile SupplierProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  storefrontProfile StorefrontProfile? @relation(fields: [storefrontProfileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([storefrontProfileId])
  @@index([createdAt(sort: Desc)])
  @@index([aiStatus])
  @@map("storefront_listings")
}

model SourcingRequest {
  id          String    @id @default(uuid()) @db.Uuid
  buyerProfileId String    @map("buyer_profile_id") @db.Uuid
  title       String    @db.Text
  companyName String    @map("company_name") @db.Text
  category    String?   @db.Text
  description String    @db.Text
  quantity    String?   @db.Text
  targetPrice String?   @map("target_price") @db.Text
  deadline    DateTime? @db.Timestamptz(6)
  targetCity     String?   @map("target_city") @db.Text
  targetProvince String?   @map("target_province") @db.Text
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // AI enrichment (normalized JSON + lifecycle)
  aiSchema     Json?     @map("ai_schema")
  aiSummary    String?   @map("ai_summary") @db.Text
  aiStatus     String    @default("pending") @map("ai_status") @db.Text
  aiEnrichedAt DateTime? @map("ai_enriched_at") @db.Timestamptz(6)
  aiError      String?   @map("ai_error") @db.Text

  buyerProfile BuyerProfile @relation(fields: [buyerProfileId], references: [id], onDelete: Cascade)

  @@index([buyerProfileId])
  @@index([createdAt(sort: Desc)])
  @@index([aiStatus])
  @@map("sourcing_requests")
}
